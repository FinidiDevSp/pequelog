{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter: Launch Debug",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "toolArgs": [
                "--track-widget-creation"
            ],
            "preLaunchTask": "flutter: pub get"
        },
        {
            "name": "Flutter: Launch Profile",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "profile",
            "preLaunchTask": "flutter: pub get"
        },
        {
            "name": "Flutter: Attach",
            "type": "dart",
            "request": "attach",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Flutter: Integration Test",
            "type": "dart",
            "request": "launch",
            "program": "integration_test/app_test.dart",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "flutter: pub get"
        }
    ]
}
